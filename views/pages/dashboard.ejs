<script src="https://cdn.jsdelivr.net/npm/dompurify@3.0.8/dist/purify.min.js"></script>
<script nonce="<%= locals.cspNonce %>">window.__dashboard = {};
window.__initialLocale = '<%= locals.locale %>';
